@page "/new-order"
@page "/new-order/step1"
@inject OrderDraftService DraftService
@inject NavigationManager Nav

<div class="top-bar">
    <div>
        <h2>Step 1: Power Entry</h2>
        <div style="color: var(--text-muted)">Enter prescription details</div>
    </div>
</div>

<div class="page-content">
    <div style="display: flex; gap: 20px; margin-bottom: 20px;">
        <!-- Right Eye -->
        <div class="card" style="flex: 1;">
            <h3 style="color: var(--accent-primary); border-bottom: 2px solid var(--border-light); padding-bottom: 10px;">Right Eye (OD)</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 15px;">
                <div>
                    <label>SPH</label>
                    <input type="text" @bind="DraftService.CurrentPrescription.RightSph" class="power-input" />
                </div>
                <div>
                    <label>CYL</label>
                    <input type="text" @bind="DraftService.CurrentPrescription.RightCyl" class="power-input" />
                </div>
                <div>
                    <label>AXIS</label>
                    <input type="text" @bind="DraftService.CurrentPrescription.RightAxis" class="power-input" />
                </div>
                <div>
                    <label>ADD</label>
                    <input type="text" @bind="DraftService.CurrentPrescription.RightAdd" class="power-input" />
                </div>
            </div>
        </div>
        
        <!-- Left Eye -->
        <div class="card" style="flex: 1;">
            <h3 style="color: var(--accent-primary); border-bottom: 2px solid var(--border-light); padding-bottom: 10px;">Left Eye (OS)</h3>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 15px;">
                <div>
                    <label>SPH</label>
                    <input type="text" @bind="DraftService.CurrentPrescription.LeftSph" class="power-input" />
                </div>
                <div>
                    <label>CYL</label>
                    <input type="text" @bind="DraftService.CurrentPrescription.LeftCyl" class="power-input" />
                </div>
                <div>
                    <label>AXIS</label>
                    <input type="text" @bind="DraftService.CurrentPrescription.LeftAxis" class="power-input" />
                </div>
                <div>
                    <label>ADD</label>
                    <input type="text" @bind="DraftService.CurrentPrescription.LeftAdd" class="power-input" />
                </div>
            </div>
        </div>
    </div>

    <div class="card" style="margin-bottom: 20px;">
        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 2fr; gap: 20px;">
            <div>
                <label>PD (mm)</label>
                <input type="text" @bind="DraftService.CurrentPrescription.Pd" class="power-input" />
            </div>
            <div>
                <label>Near PD (mm)</label>
                <input type="text" @bind="DraftService.CurrentPrescription.NearPd" class="power-input" />
            </div>
            <div>
                <label>Prism (Optional)</label>
                <input type="text" @bind="DraftService.CurrentPrescription.Prism" class="power-input" />
            </div>
            <div>
                <label>Notes (Optional)</label>
                <input type="text" @bind="DraftService.CurrentPrescription.Notes" class="power-input" />
            </div>
        </div>
    </div>
</div>

<div class="bottom-action-bar">
    <button class="btn btn-outline" @onclick="GoBack">Cancel</button>
    <button class="btn btn-primary" @onclick="GoNext">Next: Lens Type</button>
</div>

<style>
    .power-input {
        width: 100%;
        padding: 10px;
        border-radius: var(--radius-lg);
        border: 2px solid var(--accent-primary-light);
        color: var(--accent-primary);
        font-weight: bold;
        text-align: center;
        margin-top: 5px;
        outline: none;
    }
    .power-input:focus {
        border-color: var(--accent-primary);
    }
    label {
        font-size: 0.85rem;
        color: var(--text-muted);
        font-weight: 600;
    }
</style>

@code {
    private void GoBack()
    {
        Nav.NavigateTo("/");
    }

    private async Task GoNext()
    {
        await DraftService.SaveDraftAsync();
        Nav.NavigateTo("/new-order/step2");
    }
}
