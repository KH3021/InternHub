@inherits LayoutComponentBase

<div class="app-layout">
    <nav class="sidebar">
        <div style="padding: 20px; font-weight: bold; font-size: 1.2rem;">OPTIC POS</div>
        <div class="nav-links" style="display:flex; flex-direction:column; padding: 10px;">
